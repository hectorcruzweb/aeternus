# Configuración del visor de reportes. Completar las demás variables según el entorno.
# Zoom de pantalla en porcentaje (50-200). 100=normal; 135=35% más grande.
# No modifica la impresión ni los PDF. Reiniciar la configuración cacheada al cambiarlo.
REPORTES_VISOR_ZOOM=135

# Marca ESPACIO SIN CONTENIDO: true=activa; false=desactiva. Solo PDF/impresión.
REPORTES_MARCA_AGUA_CEMENTERIO=true
REPORTES_MARCA_AGUA_SERVICIOS_FUNERARIOS=true
REPORTES_MARCA_AGUA_PLANES_VENTA=true
REPORTES_MARCA_AGUA_CUOTAS=true
REPORTES_MARCA_AGUA_PAGOS=true
REPORTES_MARCA_AGUA_INVENTARIO=true
REPORTES_MARCA_AGUA_VENTAS_SALDOS=true
REPORTES_MARCA_AGUA_FACTURACION=true
REPORTES_MARCA_AGUA_SEGUIMIENTOS=true
REPORTES_MARCA_AGUA_RESUMEN_DIA=true

# Máximo de registros para PDF y vista previa del listado de pagos.
REPORTES_PAGOS_LIMITE_PDF=1000
